# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/scalable-api
# Optional extra mongoose options as JSON, e.g. {"replicaSet":"rs0"}
MONGODB_OPTIONS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (required: change these before deploying)
JWT_SECRET=change-me-access-secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=30d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (comma-separated not supported; single origin)
CORS_ORIGIN=http://localhost:3000
